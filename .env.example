# Postgres — superuser (só o container usa; nunca o app)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=troque-esta-senha
POSTGRES_DB=montese

# Postgres — role da aplicação (NOSUPERUSER, criada em postgres/init/01-app-role.sql)
POSTGRES_APP_USER=montese_app
POSTGRES_APP_PASSWORD=troque-esta-senha-tambem

# Redis
REDIS_PASSWORD=troque-esta-senha-redis

# Backend
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h

# Bcrypt rounds (F-24 do audit pré-prod). OWASP 2024 recomenda >=12.
# Hashes existentes continuam válidos após aumento (cost está no próprio
# hash). Em hardware modesto 12 = ~50ms/hash; >13 só com benchmark local.
# Default no código é 12 — declarar aqui só se quiser sobrescrever.
BCRYPT_COST=12

# Pool de conexões do Postgres (spec de Escala/Confiabilidade, ver
# docs/operations/reliability.md) — valores padrão já embutidos no código,
# só precisa declarar aqui se quiser sobrescrever.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# Rate limiting (Redis) — ver docs/operations/reliability.md
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# /auth/confirm (F-17): token tem 48h de validade + JWT + purpose distinto,
# brute-force inviável; este limite é defesa em profundidade.
AUTH_CONFIRM_RATE_LIMIT_MAX=30
AUTH_CONFIRM_RATE_LIMIT_WINDOW_SECONDS=3600
# /health (F-16): limite generoso para suportar load balancer + monitoring,
# mas bloqueia varredura abusiva que poderia martelar SELECT now().
HEALTH_RATE_LIMIT_MAX=600
HEALTH_RATE_LIMIT_WINDOW_SECONDS=60

# E-mail transacional (Resend) — ver docs/specs/fase-2-site-institucional.md
RESEND_API_KEY=
EMAIL_FROM=Montese SST <naoresponda@montesesst.com.br>
CONTACT_EMAIL_TO=
# URL pública onde o nginx atende — usada só pra montar o link absoluto do
# e-mail de confirmação de cadastro. Em produção PRECISA apontar pro
# IP/domínio real desta VPS, senão o link do e-mail fica quebrado.
PUBLIC_APP_URL=http://localhost

# Rate limiting de cadastro e contato — ver docs/specs/fase-2-site-institucional.md
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
CONTACT_RATE_LIMIT_MAX=10
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600

# Object storage (Cloudflare R2) — preenchido quando chegarmos no passo de documentos
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# MiniMax (Copiloto de IA, Fase 8) - preenchido quando o fundador assinar
MINIMAX_API_KEY=
MINIMAX_MODEL=

# OpenRouter (Copiloto de IA, Fase 8) - provedor ativo, modelo configurado
# pelo fundador direto no painel do OpenRouter (openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_RAG_MIN_SIMILARITY=0.4
AI_DRAFT_RATE_LIMIT_MAX=20
AI_DRAFT_RATE_LIMIT_WINDOW_SECONDS=3600
ASSISTANT_RATE_LIMIT_MAX=20
ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=3600
ASSISTANT_ATTACHMENT_RATE_LIMIT_MAX=10
ASSISTANT_ATTACHMENT_RATE_LIMIT_WINDOW_SECONDS=3600

# Groq (transcrição de áudio por Whisper, ata da CIPA por IA, Fase 13) -
# preenchido quando o fundador assinar
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
ATA_AUDIO_RATE_LIMIT_MAX=10
ATA_AUDIO_RATE_LIMIT_WINDOW_SECONDS=86400

# Google Calendar OAuth (integração agendamento + Meet, Fase 17) -
# preenchido pelo fundador via Cloud Console (projeto Montese SST,
# OAuth Client ID tipo "Web application"). Sem essas vars o backend
# ABORTA O BOOT (google-oauth-calendar-client.service.ts constructor)
# com mensagem explícita apontando qual var falta — não passa
# silenciosamente como antes (F-27 do audit pré-prod).
#
# GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET são exigidos pelo
# docker-compose.yml sem valor default — `docker compose config`
# falha se as duas não estiverem presentes no .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave AES-256-GCM para criptografar refresh tokens em repouso
# (tabela technician_google_accounts.refresh_token_encrypted).
# Gerar com: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
# URL base do backend (monta o redirect_uri do OAuth como
# `${APP_BASE_URL}/api/google-calendar/callback`). Default embutido
# no código é https://montesesst.com.br; só declare aqui se quiser
# sobrescrever (ex.: dev/staging com domínio diferente).
APP_BASE_URL=https://montesesst.com.br
