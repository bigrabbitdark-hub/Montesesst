diff --git a/test/cnpj-fixture.ts b/test/cnpj-fixture.ts
new file mode 100644
index 0000000..30e9543
--- /dev/null
+++ b/test/cnpj-fixture.ts
@@ -0,0 +1,31 @@
+// CNPJs SINTÉTICOS VÁLIDOS para os testes (a filial exige CNPJ com dígito verificador; a unicidade é
+// por empresa, e o CNPJ da filial não pode ser o da matriz). Raiz fictícia "9" + 7 dígitos derivados
+// da semente; filial "0001". Mesmos seeds geram o mesmo CNPJ; seeds diferentes geram CNPJs diferentes
+// (número: 1:1 até 9.999.999; texto: hash FNV-1a, colisão improvável). Mesmo módulo 11 de
+// src/common/validators/cnpj.util.ts, reimplementado aqui de propósito para o teste não depender do código testado.
+const W12 = [5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2];
+const W13 = [6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2];
+
+function checkDigit(base: string, weights: number[]): number {
+  const sum = base.split('').reduce((acc, d, i) => acc + Number(d) * weights[i], 0);
+  const rest = sum % 11;
+  return rest < 2 ? 0 : 11 - rest;
+}
+
+function seedToNumber(seed: number | string): number {
+  if (typeof seed === 'number') return Math.abs(Math.trunc(seed)) % 10_000_000;
+  let h = 0x811c9dc5;
+  for (let i = 0; i < seed.length; i++) {
+    h ^= seed.charCodeAt(i);
+    h = Math.imul(h, 0x01000193) >>> 0;
+  }
+  return h % 10_000_000;
+}
+
+/** CNPJ numérico válido (14 dígitos, sem máscara), determinístico por semente. */
+export function makeCnpj(seed: number | string): string {
+  const base = `9${String(seedToNumber(seed)).padStart(7, '0')}0001`;
+  const d1 = checkDigit(base, W12);
+  const d2 = checkDigit(base + d1, W13);
+  return `${base}${d1}${d2}`;
+}
diff --git a/test/cnpj-fixture.unit-spec.ts b/test/cnpj-fixture.unit-spec.ts
new file mode 100644
index 0000000..d483b04
--- /dev/null
+++ b/test/cnpj-fixture.unit-spec.ts
@@ -0,0 +1,23 @@
+import { isValidCnpj } from '../src/common/validators/cnpj.util';
+import { makeCnpj } from './cnpj-fixture';
+
+describe('makeCnpj (fixture de teste)', () => {
+  it('gera CNPJs numéricos válidos pelo validador real, com 14 dígitos', () => {
+    for (const seed of [0, 1, 2, 9_999_999, 'a', 'filial-1', 'ingestion-x-Filial Ing A', '']) {
+      const c = makeCnpj(seed);
+      expect(c).toMatch(/^\d{14}$/);
+      expect(isValidCnpj(c)).toBe(true);
+    }
+  });
+  it('é determinístico e distinto por semente', () => {
+    expect(makeCnpj('x')).toBe(makeCnpj('x'));
+    const set = new Set<string>();
+    for (let i = 0; i < 5000; i++) set.add(makeCnpj(i));
+    expect(set.size).toBe(5000);
+    expect(makeCnpj('Filial A1')).not.toBe(makeCnpj('Filial A2'));
+  });
+  it('usa raiz fictícia (começa com 9) e filial 0001', () => {
+    expect(makeCnpj('qualquer').slice(0, 1)).toBe('9');
+    expect(makeCnpj('qualquer').slice(8, 12)).toBe('0001');
+  });
+});
